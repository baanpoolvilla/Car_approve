# ---- Neon PostgreSQL (จำเป็น) ---------------------------------------------
# ใช้ POOLED connection string (host ต้องมีคำว่า "-pooler")
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ---- App -------------------------------------------------------------------
# URL จริงของระบบ ใช้ในลิงก์ที่แนบไปกับอีเมลแจ้งเตือน
APP_URL="https://carapprove.vercel.app"

# ---- Email แจ้งเตือน (ไม่บังคับ) -------------------------------------------
# ใช้เฉพาะการ "แจ้งเตือน" เท่านั้น การ login ไม่ต้องใช้อีเมลแล้ว
# ถ้าไม่ตั้ง ระบบยังทำงานได้ปกติ แค่ไม่ส่งอีเมล (แจ้งเตือนในระบบยังอยู่ครบ)
RESEND_API_KEY=""
EMAIL_FROM="Car Approve <onboarding@resend.dev>"

# ---- Cron (ไม่บังคับ) ------------------------------------------------------
# ป้องกัน /api/cron  Vercel Cron จะส่ง header ให้อัตโนมัติเมื่อตั้งค่าไว้
CRON_SECRET=""

# ---- เข้าสู่ระบบจาก SmartBoss (ไม่บังคับ) ----------------------------------
# secret ร่วมกับ SmartBoss (ฝั่งโน้นชื่อ SSO_CARAPPROVE_SECRET ค่าเดียวกันเป๊ะ)
# สร้างด้วย: openssl rand -base64 48 · ไม่ตั้ง = ปิดทางเข้าจาก SmartBoss (login ด้วยรหัสตามเดิม)
SSO_SECRET=""
