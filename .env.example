# ---- Neon PostgreSQL -------------------------------------------------------
# Use the POOLED connection string (host contains "-pooler") for the app.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ---- App -------------------------------------------------------------------
# Public URL, used in notification emails.
APP_URL="http://localhost:3000"

# ---- Email (optional) ------------------------------------------------------
# Without this the 6-digit login code is shown on screen and logged to the
# server console instead of being emailed.
RESEND_API_KEY=""
EMAIL_FROM="Car Approve <onboarding@resend.dev>"

# ---- Cron (optional) -------------------------------------------------------
# Protects /api/cron. Vercel Cron sends it automatically once set in the project.
CRON_SECRET=""
